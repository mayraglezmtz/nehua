# Nehua Environment Configuration

# Next.js Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-key-here

# GitHub OAuth Configuration
# Get these from: https://github.com/settings/developers
GITHUB_ID=your-github-oauth-app-id
GITHUB_SECRET=your-github-oauth-app-secret

# Kiro MCP Configuration for Gemini API
# Configure your Kiro CLI endpoint for Gemini API access
KIRO_API_ENDPOINT=http://localhost:8000
KIRO_API_KEY=your-kiro-api-key-if-required

# Optional: Development Configuration
NODE_ENV=development

# Kiro MCP Setup Instructions:
# 1. Ensure Kiro CLI is installed and configured with Gemini API
# 2. Start Kiro MCP server: `kiro mcp start --port 8000`
# 3. Verify endpoint responds at: http://localhost:8000/api/gemini/generate
# 4. Update KIRO_API_ENDPOINT if using different port/host